# Copy to .env (gitignored). docker compose and show.py both read it.

# Both Neo4j servers' password (at least 8 characters).
NEO4J_PASSWORD=plant-assistant

# Optional: Claude answers live, and free-form questions are on. Without it the scripted
# questions answer from recordings/answers.json.
ANTHROPIC_API_KEY=

# Host ports. On macOS, AirPlay Receiver holds 5000: use another, e.g. 5050.
STETIQ_PORT=5000
CANDIDATE_PORT=7687
PRODUCTION_PORT=7688
ASSISTANT_PORT=8000
